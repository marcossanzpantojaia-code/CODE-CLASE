# Copy to .env (never commit real values). In staging/production inject these
# from the platform's secret manager.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
# production | staging | development | test  (shown in logs, health and evidence)
APP_ENV=staging
# all = web + worker in one process; or run "web" and "worker" separately
ROLE=all
PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL >= 13, btree_gist extension available) -----------
DATABASE_URL=postgres://user:password@host:5432/receptionist
DATABASE_POOL_MAX=10
# disable | require | no-verify
DATABASE_SSL=require

# --- WhatsApp Business Platform (Cloud API) --------------------------------
# Meta App > Settings > Basic > App secret (signs webhooks: X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Any random string >= 16 chars; the same value goes in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=
# System user permanent token with whatsapp_business_messaging permission.
# Channels reference it as env:WHATSAPP_ACCESS_TOKEN (tenant file accessTokenRef).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# --- LLM (Claude) -------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1
# Prices used for cost estimation (USD per million tokens) - keep in sync with the model
LLM_PRICE_INPUT_PER_MTOK=4
LLM_PRICE_OUTPUT_PER_MTOK=20
LLM_PRICE_CACHE_READ_PER_MTOK=0.2
LLM_PRICE_CACHE_WRITE_PER_MTOK=5

# --- Kill switches (global). Tenants also have their own flags in the DB -----
# Master switch for automatic replies. Default false: turn on deliberately.
AUTOMATED_RECEPTIONIST_ENABLED=false
# true = no automatic replies; messages stored and conversations flagged for humans
SAFE_MODE=false
# false = hold every outbound send (nothing is lost; resumes when true)
OUTBOUND_MESSAGING_ENABLED=true

# --- Observability ---------------------------------------------------------------
# Required to expose /metrics in staging/production (Bearer token)
METRICS_TOKEN=
